generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ CORE TABLES ============

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String
  password    String?
  avatar      String?
  age         Int?
  plan        String    @default("free")
  preferences String    @default("{}")
  role        String    @default("user")
  description String?
  pin         String?
  createdAt   DateTime  @default(now())
  lastSeen    DateTime  @default(now())

  familyMembers      FamilyMember[]
  invitationsCreated Invitation[]
  topics             Topic[]
  userTopicProgress  UserTopicProgress[]
  projects           Project[]
  conversations      Conversation[]
  messages           Message[]
  xpNotifications    XpNotification[]
  badges             UserBadge[]
  skillProgress      UserSkillProgress[]
  userPresence       UserPresence?
  sharedEntities     SharedEntity[]
  initiatedSessions  CollaborativeSession[]  @relation("InitiatedBy")
  sessionParticipations SessionParticipant[]
  collaborationEvents CollaborationEvent[]
  userMemory         AgoraUserMemory[]
  postActionBuffer   AgoraPostActionBuffer[]
  memoryAudit        AgoraMemoryAudit[]
  presenceUpdates    PresenceUpdate[]
  agoraStableState   AgoraStableState?
  agoraSessionContexts AgoraSessionContext[]
  projectComments    ProjectComment[]

  @@map("users")
}

model Family {
  id        String   @id @default(uuid())
  name      String
  pin       String?
  createdAt DateTime @default(now())

  members           FamilyMember[]
  invitations       Invitation[]
  sharedEntities    SharedEntity[]
  collaborativeSessions CollaborativeSession[]
  collaborationEvents CollaborationEvent[]
  userPresence      UserPresence[]

  @@map("families")
}

model FamilyMember {
  id       String   @id @default(uuid())
  familyId String
  userId   String
  role     String   @default("Child")
  joinedAt DateTime @default(now())
  active   Boolean  @default(true)
  stats    String   @default("{}")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

model Invitation {
  id        String    @id @default(uuid())
  familyId  String
  email     String
  token     String    @unique
  status    String    @default("Pending")
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@map("invitations")
}

// ============ LEARNING TABLES ============

model Topic {
  id          String   @id @default(uuid())
  title       String
  category    String?
  description String?
  content     String?
  instruction String?
  depth       Int      @default(1)
  maxDepth    Int      @default(7)
  engagement  Int      @default(0)
  connections Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdBy   String?

  creator    User?              @relation(fields: [createdBy], references: [id])
  resources  Resource[]
  progress   UserTopicProgress[]
  edgesFrom  TopicEdge[]        @relation("EdgeSource")
  edgesTo    TopicEdge[]        @relation("EdgeTarget")
  conversations Conversation[]

  @@map("topics")
}

model TopicEdge {
  id       String @id @default(uuid())
  sourceId String
  targetId String
  type     String @default("default")
  weight   Int    @default(1)

  source Topic @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Topic @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@map("topic_edges")
}

model Resource {
  id       String @id @default(uuid())
  topicId  String
  title    String
  type     String
  url      String?
  viewStatus String @default("Locked")
  metadata String?
  createdAt DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model UserTopicProgress {
  userId          String
  topicId         String
  currentDepth    Int      @default(1)
  engagementScore Int      @default(0)
  lastActive      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@map("user_topic_progress")
}

// ============ PROJECT TABLES ============

model Project {
  id              String   @id @default(uuid())
  userId          String
  title           String
  status          String   @default("active")
  whyText         String?
  scopeText       String?
  nextStep        String?
  blockers        String?
  definitionOfDone String?
  originTopicId   String?
  visibility      String   @default("private")
  whyCare         String?
  intent          String?
  supportNotes    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts  ProjectArtifact[]
  reflections ProjectReflection[]
  comments   ProjectComment[]

  @@map("projects")
}

model ProjectArtifact {
  id        String   @id @default(uuid())
  projectId String
  name      String
  type      String
  content   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_artifacts")
}

model ProjectReflection {
  id        String   @id @default(uuid())
  projectId String
  content   String
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_reflections")
}

model ProjectComment {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  content   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project_comments")
}

// ============ CONVERSATION TABLES ============

model Conversation {
  id      String   @id @default(uuid())
  userId  String
  topicId String?
  title   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic   Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages Message[]
  postActionBuffers AgoraPostActionBuffer[]

  @@map("conversations")
}

model Message {
  id            String   @id @default(uuid())
  conversationId String
  role          String
  content       String
  createdAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?

  @@map("messages")
}

// ============ COLLABORATION TABLES ============

model SharedEntity {
  id          String   @id @default(uuid())
  familyId    String
  entityType  String
  entityId    String
  sharedBy    String
  sharedAt    DateTime @default(now())
  title       String
  description String?
  isPublic    Boolean  @default(false)
  tags        String?
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [sharedBy], references: [id])

  @@map("shared_entities")
}

model UserPresence {
  id                String   @id @default(uuid())
  userId            String   @unique
  familyId          String?
  status            String   @default("offline")
  lastSeen          DateTime @default(now())
  currentActivity   String?
  currentEntityType String?
  currentEntityId   String?
  socketId          String?
  isVisible         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@map("user_presence")
}

model CollaborativeSession {
  id               String   @id @default(uuid())
  familyId         String
  sharedEntityId   String?
  initiatedBy      String
  sessionType      String
  title            String
  description      String?
  scheduledFor     DateTime?
  startsAt         DateTime @default(now())
  endsAt           DateTime?
  maxParticipants  Int      @default(10)
  isActive         Boolean  @default(true)
  settings         String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  family      Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  initiator   User                  @relation("InitiatedBy", fields: [initiatedBy], references: [id])
  participants SessionParticipant[]
  events      CollaborationEvent[]

  @@map("collaborative_sessions")
}

model SessionParticipant {
  id                String    @id @default(uuid())
  sessionId         String
  userId            String
  role              String    @default("participant")
  joinedAt          DateTime  @default(now())
  leftAt            DateTime?
  contributionScore Int       @default(0)
  status            String    @default("active")
  metadata          String    @default("{}")

  session CollaborativeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("session_participants")
}

model CollaborationEvent {
  id          String   @id @default(uuid())
  sessionId   String?
  familyId    String
  userId      String
  eventType   String
  eventData   String   @default("{}")
  entityType  String?
  entityId    String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  session CollaborativeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  family  Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id])

  @@map("collaboration_events")
}

// ============ SKILLS TABLES ============

model Skill {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   @default("General")
  depth       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edgesFrom     SkillEdge[] @relation("EdgeSource")
  edgesTo       SkillEdge[] @relation("EdgeTarget")
  userProgress  UserSkillProgress[]

  @@map("skills")
}

model SkillEdge {
  id       String @id @default(uuid())
  sourceId String
  targetId String
  type     String @default("sub_skill")
  weight   Int    @default(1)
  createdAt DateTime @default(now())

  source Skill @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Skill @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@map("skill_edges")
}

model UserSkillProgress {
  id               String    @id @default(uuid())
  userId           String
  skillId          String
  level            Int       @default(0)
  xp               Int       @default(0)
  confidenceScore  Int       @default(0)
  lastPracticedAt  DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skill_progress")
}

// ============ AGORA (AI MEMORY) TABLES ============

model AgoraStableState {
  userId           String   @id
  userRole         String   @default("adult")
  familyBoundaries String   @default("{}")
  consentFlags     String   @default("{\"memory_enabled\":true,\"trait_inference\":true,\"cross_session_learning\":true}")
  subscriptionTier String   @default("free")
  languagePref     String   @default("en")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agora_stable_state")
}

model AgoraUserMemory {
  id          String   @id @default(uuid())
  userId      String
  traitKey    String
  traitValue  String
  confidence  Float    @default(0.5)
  lastConfirmed DateTime @default(now())
  decayFactor Float    @default(1.0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, traitKey])
  @@map("agora_user_memory")
}

model AgoraSessionContext {
  id              String    @id @default(uuid())
  sessionId       String    @unique
  userId          String
  activeTopic     String?
  currentPosture  String    @default("guide")
  taskIntent      String?
  constraints     String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agora_session_context")
}

model AgoraPostActionBuffer {
  id              String    @id @default(uuid())
  agentId         String
  userId          String
  signalType      String
  signalData      String
  conversationId  String?
  processed       Boolean   @default(false)
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@map("agora_post_action_buffer")
}

model AgoraMemoryAudit {
  id          String   @id @default(uuid())
  userId      String
  traitKey    String
  changeType  String
  oldValue    String?
  newValue    String?
  changedBy   String
  changeReason String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agora_memory_audit")
}

// ============ XP & BADGES TABLES ============

model XpNotification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  xpAmount  Int      @default(0)
  read      Boolean  @default(false)
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_notifications")
}

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  category    String?
  criteria    String?
  createdAt   DateTime @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  metadata  String   @default("{}")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ============ FOLDERS TABLE ============

model Folder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("folders")
}

// ============ ACTIONS TABLE ============

model Action {
  id        String   @id @default(uuid())
  userId    String
  type      String
  entityType String?
  entityId  String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@map("actions")
}

// ============ SYSTEM PROMPTS TABLE ============

model SystemPrompt {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  version   Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_prompts")
}

// ============ ACTIVITY LOG TABLE ============

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entityType String?
  entityId  String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@map("activity_log")
}

// ============ PRESENCE UPDATES TABLE ============

model PresenceUpdate {
  id        String   @id @default(uuid())
  userId    String
  familyId  String?
  event     String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("presence_updates")
}
